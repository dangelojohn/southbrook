<?xml version="1.0" encoding="utf-8"?>
<!--
  Southbrook Trade Portal — public landing (/).

  2026-06-03 — replaces the prior consumer-marketing homepage (hero,
  three-up feature blocks, CTA strip) with the same mobile-first
  trade-portal shell rendered at /web/login.

  Rationale: this site is the access gate for approved contractors
  and high-end designers, not a public marketing page. Visitors who
  hit / should immediately see the portal entry — logo, brand,
  "Log in" button, "Request access" fallback, portal area shortcuts —
  not generic value-prop copy.

  Shares all styling with views/auth_template.xml via
  static/src/scss/trade_portal.scss. The auth chrome embeds the
  stock Odoo form at this exact spot; this homepage uses an explicit
  "Log in" anchor to /web/login instead.

  The public marketing chrome (navbar, footer, "Your Logo" placeholder,
  fake company email/phone, About Us / Newsletter columns) injected
  by website.layout is hidden via SCSS using `body:has(.o_sb_tp)` —
  no second XML inherit, no body-class plumbing.
-->
<odoo>

  <template
      id="southbrook_homepage"
      name="Southbrook Trade Portal — Homepage"
      inherit_id="website.homepage">

    <!-- Replace the entire wrap. Odoo 19 ships
         `<div id="wrap">…</div>` in website.homepage; we swap the
         children for the trade-portal shell. -->
    <xpath expr="//div[@id='wrap']" position="replace">
      <div id="wrap" class="oe_structure oe_empty">
        <div class="o_sb_tp">
          <div class="o_sb_tp_shell">

            <!-- Logo -->
            <div class="o_sb_tp_logo_row">
              <a href="/" aria-label="Southbrook Cabinetry">
                <img class="o_sb_tp_logo"
                     src="/southbrook_estimating_website/static/src/img/southbrook_logo.png"
                     alt="Southbrook Cabinetry"/>
              </a>
            </div>

            <!-- Primary card: brand copy + Log in / Request access -->
            <div class="o_sb_tp_card">
              <p class="o_sb_tp_eyebrow">Approved access</p>
              <h1 class="o_sb_tp_title">Trade Portal</h1>
              <p class="o_sb_tp_body">
                Log in to view active cabinet projects, quote status,
                drawings, and revisions.
              </p>

              <!-- Resolve Request-access target: signup if uninvited
                   signup is enabled, otherwise the contact page. -->
              <t t-set="_inv_scope"
                 t-value="request.env['ir.config_parameter'].sudo().get_param('auth_signup.invitation_scope', 'b2b')"/>
              <t t-set="_request_access_url"
                 t-value="'/web/signup' if _inv_scope == 'b2c' else '/contactus'"/>

              <div class="o_sb_tp_actions">
                <a href="/web/login"
                   class="o_sb_tp_btn o_sb_tp_btn_primary">
                  Log in
                </a>
                <a t-att-href="_request_access_url"
                   class="o_sb_tp_btn o_sb_tp_btn_secondary">
                  Request access
                </a>
              </div>
            </div>

            <!-- Compact tap-targets — anonymous taps land at login. -->
            <div class="o_sb_tp_tiles">
              <a href="/web/login?redirect=%2Fmy%2Fquotes"
                 class="o_sb_tp_tile">
                <svg class="o_sb_tp_tile_icon" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                  <path d="M6 3h9l5 5v13H6z"/>
                  <path d="M14 3v6h6"/>
                  <path d="M9 14h7M9 17h5"/>
                </svg>
                <span>Quotes</span>
              </a>
              <a href="/web/login?redirect=%2Fmy%2Fprojects"
                 class="o_sb_tp_tile">
                <svg class="o_sb_tp_tile_icon" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                  <path d="M3 7h6l2 2h10v11H3z"/>
                </svg>
                <span>Projects</span>
              </a>
              <a href="/web/login?redirect=%2Fmy%2Fdrawings"
                 class="o_sb_tp_tile">
                <svg class="o_sb_tp_tile_icon" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                  <path d="M4 4h12l4 4v12H4z"/>
                  <path d="M8 12h8M8 16h5"/>
                </svg>
                <span>Drawings</span>
              </a>
            </div>

            <!-- Trust / status pills -->
            <ul class="o_sb_tp_trust">
              <li>Odoo backed</li>
              <li>Secure login</li>
              <li>For contractors and design partners</li>
              <li>Mobile ready</li>
            </ul>

            <!-- Footer help -->
            <p class="o_sb_tp_help">
              Need help with your login?
              <a href="/contactus">Contact Southbrook</a>
            </p>

          </div>
        </div>
      </div>
    </xpath>

  </template>

</odoo>
