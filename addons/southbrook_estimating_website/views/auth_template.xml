<?xml version="1.0" encoding="utf-8"?>
<!--
  Southbrook Trade Portal — auth chrome.

  2026-06-03 — replaces the earlier walnut/linen consumer-flow login
  layout with a mobile-first private trade portal for approved
  contractors and high-end designers.

  Inherits two stock auth templates:

    1. `web.login_layout`   — shared chrome for /web/login,
                              /web/signup, /web/reset_password.
                              Replaces the narrow stock card with
                              the trade-portal shell. Stock form is
                              re-emitted via t-out="0" inside the
                              shell so login, signup, and password
                              reset POSTs continue to work.

    2. `web.login`          — drops the multi-account `user_switch`
                              picker and forces the form visible
                              (the stock template hides it until a
                              login is pre-populated, which is
                              wrong for this single-tenant portal).

  Form semantics, CSRF token, redirect param, and signup/reset
  routes are untouched — only the surrounding chrome is rewritten.
-->
<odoo>

  <!-- ================================================================
       Brand the shared login / signup / reset-password chrome.
       ================================================================ -->
  <template
      id="login_layout_southbrook"
      name="Southbrook Trade Portal — Auth Layout"
      inherit_id="web.login_layout"
      priority="30">

    <!-- The website module collapses web.login_layout down to a
         single <div class="oe_website_login_container" t-out="0"/>.
         REPLACE that wrapper with the trade-portal shell. The
         original t-out="0" hook is re-emitted inside the form card
         so the underlying Odoo login / signup / reset form renders
         exactly where it would have, just inside our chrome. -->
    <xpath expr="//div[hasclass('oe_website_login_container')]"
           position="replace">
      <div class="o_sb_tp">
        <div class="o_sb_tp_shell">

          <!-- Logo -->
          <div class="o_sb_tp_logo_row">
            <a href="/" aria-label="Southbrook Cabinetry">
              <img class="o_sb_tp_logo"
                   src="/southbrook_estimating_website/static/src/img/southbrook_logo.png"
                   alt="Southbrook Cabinetry"/>
            </a>
          </div>

          <!-- Primary card: portal copy + stock form -->
          <div class="o_sb_tp_card">
            <p class="o_sb_tp_eyebrow">Approved access</p>
            <h1 class="o_sb_tp_title">Trade Portal</h1>
            <p class="o_sb_tp_body">
              Log in to view active cabinet projects, quote status,
              drawings, and revisions.
            </p>

            <!-- Stock Odoo form (login / signup / reset). The
                 wrapping div gives our SCSS a hook without
                 changing the form's name / action / CSRF token. -->
            <div class="o_sb_tp_form">
              <t t-out="0"/>
            </div>

            <!-- Secondary action: Request access. Routes to
                 /web/signup when uninvited signup is enabled;
                 otherwise falls back to /contactus. Resolved at
                 render time so toggling the system parameter
                 (auth_signup.invitation_scope) in the backend
                 instantly switches the link without a redeploy. -->
            <t t-set="_inv_scope"
               t-value="request.env['ir.config_parameter'].sudo().get_param('auth_signup.invitation_scope', 'b2b')"/>
            <t t-set="_request_access_url"
               t-value="'/web/signup' if _inv_scope == 'b2c' else '/contactus'"/>

            <div class="o_sb_tp_actions">
              <a t-att-href="_request_access_url"
                 class="o_sb_tp_btn o_sb_tp_btn_secondary">
                Request access
              </a>
            </div>
          </div>

          <!-- Compact tap-targets: Quotes / Projects / Drawings.
               Each lands at the corresponding /my portal area,
               routed through /web/login so anonymous taps land
               on the login form instead of a 403. -->
          <div class="o_sb_tp_tiles">
            <a href="/web/login?redirect=%2Fmy%2Fquotes"
               class="o_sb_tp_tile">
              <svg class="o_sb_tp_tile_icon" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="1.7"
                   stroke-linecap="round" stroke-linejoin="round"
                   aria-hidden="true">
                <path d="M6 3h9l5 5v13H6z"/>
                <path d="M14 3v6h6"/>
                <path d="M9 14h7M9 17h5"/>
              </svg>
              <span>Quotes</span>
            </a>
            <a href="/web/login?redirect=%2Fmy%2Fprojects"
               class="o_sb_tp_tile">
              <svg class="o_sb_tp_tile_icon" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="1.7"
                   stroke-linecap="round" stroke-linejoin="round"
                   aria-hidden="true">
                <path d="M3 7h6l2 2h10v11H3z"/>
              </svg>
              <span>Projects</span>
            </a>
            <a href="/web/login?redirect=%2Fmy%2Fdrawings"
               class="o_sb_tp_tile">
              <svg class="o_sb_tp_tile_icon" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="1.7"
                   stroke-linecap="round" stroke-linejoin="round"
                   aria-hidden="true">
                <path d="M4 4h12l4 4v12H4z"/>
                <path d="M8 12h8M8 16h5"/>
              </svg>
              <span>Drawings</span>
            </a>
          </div>

          <!-- Trust / status pills -->
          <ul class="o_sb_tp_trust">
            <li>Odoo backed</li>
            <li>Secure login</li>
            <li>For contractors and design partners</li>
            <li>Mobile ready</li>
          </ul>

          <!-- Footer help -->
          <p class="o_sb_tp_help">
            Need help with your login?
            <a href="/contactus">Contact Southbrook</a>
          </p>

        </div>
      </div>
    </xpath>
  </template>

  <!-- ================================================================
       Always show the stock /web/login form. Odoo 19's web.login
       template emits an `<owl-component name="web.user_switch"/>`
       multi-account picker and sets the form to `d-none` until a
       login is pre-populated. For a single-tenant trade portal,
       the picker is wrong and the form must always render.
       ================================================================ -->
  <template
      id="login_form_always_visible"
      name="Southbrook — always show login form"
      inherit_id="web.login">

    <xpath expr="//owl-component[@name='web.user_switch']"
           position="replace"/>

    <xpath expr="//form[@t-attf-action]"
           position="attributes">
      <attribute name="t-attf-class">oe_login_form</attribute>
    </xpath>
  </template>

</odoo>
